# ============================================================
# KashRoot Web — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ============================================================

# Backend API base URL (no trailing slash)
# Development: http://localhost:3001/api/v1
# Production:  https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# WebSocket / Socket.IO server URL (no trailing slash)
# Development: http://localhost:3001
# Production:  wss://api.yourdomain.com
NEXT_PUBLIC_WS_URL=http://localhost:3001

# IFSC bank lookup for the KYC panel.
# false (default): /api/ifsc proxies the public Razorpay IFSC directory.
# true:            answer from a local bank-code table — offline work and demos.
NEXT_PUBLIC_IFSC_MOCK=false
