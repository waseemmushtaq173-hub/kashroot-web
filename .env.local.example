# ============================================================
# KashRoot Web — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ============================================================

# Backend API base URL (no trailing slash)
# Development: http://localhost:3001/api/v1
# Production:  https://api.yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# WebSocket / Socket.IO server URL (no trailing slash)
# Development: http://localhost:3001
# Production:  wss://api.yourdomain.com
NEXT_PUBLIC_WS_URL=http://localhost:3001

# KYC panel IFSC lookup. Unset/false = live lookup through /api/ifsc (proxies
# the public Razorpay IFSC directory); true = offline bank-code table for demos.
NEXT_PUBLIC_IFSC_MOCK=false

# ── Supabase (sign-in, fertiliser batch registry) ───────────────────────────
# Project URL and the anon/publishable key ONLY. Never put the service_role /
# sb_secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Live mandi prices (data.gov.in / Agmarknet) ─────────────────────────────
# Free key: data.gov.in → sign up → My Account. Without it a small public
# sample is used.
DATA_GOV_IN_API_KEY=

# ── Weather (Open-Meteo) ────────────────────────────────────────────────────
# Free for non-commercial use without a key. Commercial plan key (optional):
OPEN_METEO_API_KEY=

# ── AI voice assistant (Claude) ──────────────────────────────────────────────
# From console.anthropic.com → API Keys (needs prepaid credit). Server-only.
ANTHROPIC_API_KEY=

# ── Live vehicle data (ULIP: VAHAN + FASTag) — company registration at goulip.in
ULIP_USERNAME=
ULIP_PASSWORD=
# Staging: https://www.ulipstaging.dpiit.gov.in/ulip/v1.0.0
# ULIP_BASE_URL=

# ── KYC, free offline mode (default) ────────────────────────────────────────
# Aadhaar is verified for free from UIDAI's signed Offline e-KYC ZIP or the
# Aadhaar Secure QR. UIDAI's 2021 and 2024 keys are built in. When UIDAI
# publishes a newer key, download "uidai_offline_publickey_<date>.cer" from
# uidai.gov.in, convert it to PEM if needed (openssl x509 -inform der -in f.cer)
# and paste the PEM block(s) here (\n for line breaks is fine):
UIDAI_OFFLINE_CERTS=

# ── KYC, online mode: Aadhaar OTP, PAN, DigiLocker (Sandbox.co.in) ──────────
# Adding these two switches the KYC panel to online checks automatically.
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
# SANDBOX_BASE_URL=https://api.sandbox.co.in

# ── SMS + email verification codes ──────────────────────────────────────────
# A long random string used to sign codes (required).
OTP_SECRET=
# SMS: MSG91 (preferred in India, needs a DLT template with ##OTP##) …
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# … or Twilio …
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# … or Fast2SMS.
FAST2SMS_API_KEY=
# Fast2SMS route: otp (default; needs website verification in Fast2SMS → OTP Message),
# q (Quick SMS: no verification, higher price), or dlt (+ FAST2SMS_SENDER_ID, FAST2SMS_TEMPLATE_ID).
# FAST2SMS_ROUTE=otp
# WhatsApp OTP (Meta WhatsApp Cloud API — no DLT needed): a permanent token, the
# sender's phone number ID, and an approved AUTHENTICATION template (copy-code button).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=en
# Email: Resend (RESEND_FROM must be on a domain verified in Resend) …
RESEND_API_KEY=
RESEND_FROM=
# … or Gmail SMTP with an app password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
