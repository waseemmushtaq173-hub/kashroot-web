generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ChatMessage {
  id           String     @id
  threadId     String
  content      String
  senderUserId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  ChatThread   ChatThread @relation(fields: [threadId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ChatThread {
  id            String        @id
  appointmentId String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  isArchived    Boolean       @default(false)
  ChatMessage   ChatMessage[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model FeeVersion {
  id             String   @id
  serviceFeesPct Decimal
  created_at     DateTime @default(now())
  orders         orders[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Payment {
  id          String   @id
  order_id    String
  amount      Decimal  @db.Decimal(12, 4)
  currency    String
  providerRef String?
  created_at  DateTime @default(now())
  updated_at  DateTime
  orders      orders   @relation(fields: [order_id], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model addresses {
  id          String   @id
  user_id     String
  region_id   String?
  line1       String
  line2       String?
  city        String
  postal_code String
  country     String
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now())
  regions     regions? @relation(fields: [region_id], references: [id])
  users       User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders      orders[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model agency_pesticide_inspections {
  id                       String             @id
  tester_profile_id        String
  agency_name              String
  product_brand            String
  scanned_batch_no         String?
  scanned_bottle_image_url String
  verdict                  inspection_verdict
  match_confidence         Float
  discrepancy_report       Json?
  created_at               DateTime           @default(now())
  updated_at               DateTime
  tester_profiles          tester_profiles    @relation(fields: [tester_profile_id], references: [id], onDelete: Cascade)

  @@index([product_brand])
  @@index([tester_profile_id, created_at])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model appointment_notes {
  id             String       @id
  appointment_id String
  author_user_id String
  note           String
  created_at     DateTime     @default(now())
  appointments   appointments @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  users          User        @relation(fields: [author_user_id], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model appointments {
  id                  String              @id
  farmer_profile_id   String
  buyer_profile_id    String
  listing_id          String?
  type                appointment_type
  status              appointment_status  @default(REQUESTED)
  proposed_slots      Json
  confirmed_slot_utc  DateTime?
  requester_timezone  String?
  farmer_timezone     String?
  cancellation_reason String?
  is_required         Boolean             @default(true)
  created_at          DateTime            @default(now())
  updated_at          DateTime
  appointment_notes   appointment_notes[]
  buyer_profiles      buyer_profiles      @relation(fields: [buyer_profile_id], references: [id])
  farmer_profiles     farmer_profiles     @relation(fields: [farmer_profile_id], references: [id])
  listings            listings?           @relation(fields: [listing_id], references: [id])
  orders              orders[]

  @@index([buyer_profile_id, status])
  @@index([farmer_profile_id, status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id            String   @id
  actor_user_id String?
  action        String
  target_type   String
  target_id     String
  ip_address    String?
  device_info   Json?
  metadata      Json?
  created_at    DateTime @default(now())
  users         User?   @relation(fields: [actor_user_id], references: [id])

  @@index([actor_user_id, created_at(sort: Desc)])
  @@index([target_type, target_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model buyer_farmer_relationships {
  id                        String          @id
  buyer_profile_id          String
  farmer_profile_id         String
  completed_orders          Int             @default(0)
  dispute_count             Int             @default(0)
  appointment_skip_eligible Boolean         @default(false)
  first_order_at            DateTime?
  last_order_at             DateTime?
  buyer_profiles            buyer_profiles  @relation(fields: [buyer_profile_id], references: [id])
  farmer_profiles           farmer_profiles @relation(fields: [farmer_profile_id], references: [id])

  @@unique([buyer_profile_id, farmer_profile_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model buyer_profiles {
  id                         String                       @id
  user_id                    String                       @unique
  display_name               String
  buyer_type                 buyer_type
  trust_score                Decimal                      @default(50) @db.Decimal(5, 2)
  no_show_count              Int                          @default(0)
  default_currency           String                       @default("INR")
  created_at                 DateTime                     @default(now())
  updated_at                 DateTime
  appointments               appointments[]
  buyer_farmer_relationships buyer_farmer_relationships[]
  users                      User                        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders                     orders[]
  saved_farmers              saved_farmers[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categories {
  id                 String         @id
  name               String
  slug               String         @unique
  parent_category_id String?
  icon_url           String?
  categories         categories?    @relation("categoriesTocategories", fields: [parent_category_id], references: [id])
  other_categories   categories[]   @relation("categoriesTocategories")
  listings           listings[]
  mandi_prices       mandi_prices[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model certifications {
