  updated_at             DateTime
  stock                  Int
  appointments           appointments[]
  listing_certifications listing_certifications[]
  listing_photos         listing_photos[]
  categories             categories?              @relation(fields: [category_id], references: [id])
  farmer_profiles        farmer_profiles          @relation(fields: [farmer_profile_id], references: [id], onDelete: Cascade)
  regions                regions?                 @relation(fields: [origin_region_id], references: [id])
  orders                 orders[]

  @@index([origin_region_id, category_id, status])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
