/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model orders {
  id                                            String                 @id
  buyer_profile_id                              String
  farmer_profile_id                             String
  listing_id                                    String
  appointment_id                                String
  fee_config_version_id                         String
  quantity                                      Decimal                @db.Decimal(12, 4)
  unit_price                                    Decimal                @db.Decimal(12, 4)
  currency                                      String
  subtotal                                      Decimal                @db.Decimal(12, 4)
  service_fee                                   Decimal                @db.Decimal(12, 4)
  shipping_estimate                             Decimal                @default(0) @db.Decimal(12, 4)
  customs_duty_estimate                         Decimal                @default(0) @db.Decimal(12, 4)
  total                                         Decimal                @db.Decimal(12, 4)
  trade_direction                               trade_direction
  origin_region_id                              String?
  destination_region_id                         String?
  buyer_shipping_address_id                     String?
  status                                        order_status           @default(PLACED)
  created_at                                    DateTime               @default(now())
  updated_at                                    DateTime
  pricingSnapshot                               Json?
  feeVersionId                                  String?
  Payment                                       Payment[]
  customs_documents                             customs_documents[]
  disputes                                      disputes[]
  order_status_history                          order_status_history[]
  appointments                                  appointments           @relation(fields: [appointment_id], references: [id])
  buyer_profiles                                buyer_profiles         @relation(fields: [buyer_profile_id], references: [id])
  addresses                                     addresses?             @relation(fields: [buyer_shipping_address_id], references: [id])
  regions_orders_destination_region_idToregions regions?               @relation("orders_destination_region_idToregions", fields: [destination_region_id], references: [id])
  farmer_profiles                               farmer_profiles        @relation(fields: [farmer_profile_id], references: [id])
  FeeVersion                                    FeeVersion?            @relation(fields: [feeVersionId], references: [id])
  fee_config_versions                           fee_config_versions    @relation(fields: [fee_config_version_id], references: [id])
  listings                                      listings               @relation(fields: [listing_id], references: [id])
  regions_orders_origin_region_idToregions      regions?               @relation("orders_origin_region_idToregions", fields: [origin_region_id], references: [id])
  payouts                                       payouts[]
  reviews                                       reviews[]
  shipments                                     shipments[]

  @@index([buyer_profile_id, status])
  @@index([farmer_profile_id, status])
  @@index([trade_direction, created_at(sort: Desc)])
}

