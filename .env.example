# KashRoot settings. Copy to .env.local for your computer; on the live site set
# them in Vercel → Project → Settings → Environment Variables (Production).
# NEVER commit a filled-in copy. Only NEXT_PUBLIC_* values reach browsers — so
# a NEXT_PUBLIC_ value must be safe for anyone to see (src/instrumentation.ts
# refuses to start if a secret is put in one). Everything else stays on the server.
# There is no database password or service-role key here on purpose: the site
# reaches the database only through Supabase's API, as each signed-in user,
# under row-level security.

# ── Public (sent to every browser — safe by design) ──
NEXT_PUBLIC_SUPABASE_URL=            # https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # the anon / publishable key (row-level security protects the data)
NEXT_PUBLIC_SITE_URL=                # https://kashroot-web.vercel.app (links in emails)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=      # Cloudflare Turnstile site key — the "I am human" check (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Server only: secrets ──
KYC_DB_SECRET=                       # from `select public.kr_kyc_secret();` in the Supabase SQL Editor
OTP_SECRET=                          # 32+ random characters, signs one-time codes
TURNSTILE_SECRET_KEY=                # Cloudflare Turnstile secret (with the site key above)
ANTHROPIC_API_KEY=                   # photo checks and the advisory first note
GOOGLE_TTS_API_KEY=                  # KashRoot's own voice (Text-to-Speech API only)
DATA_GOV_IN_API_KEY=                 # mandi prices (Agmarknet)
OPEN_METEO_API_KEY=                  # optional (commercial Open-Meteo)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
SANDBOX_API_KEY=                     # PAN / Aadhaar checks
SANDBOX_API_SECRET=
ULIP_USERNAME=                       # vehicle look-up (Government ULIP)
ULIP_PASSWORD=
TURN_USERNAME=                       # video-call relay
TURN_CREDENTIAL=

# ── Server only: settings (not secret) ──
AI_PHOTO_DAILY_LIMIT=500
TTS_DAILY_LIMIT=3000
FAST2SMS_ROUTE=
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID=
MSG91_TEMPLATE_ID=
TWILIO_PHONE_NUMBER=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=
RESEND_FROM=
TURN_URLS=
GOOGLE_TTS_VOICE_EN=
GOOGLE_TTS_VOICE_HI=
GOOGLE_TTS_VOICE_UR=
