# KASHROOT ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------
# NEVER COMMIT ACTUAL SECRETS TO VERSION CONTROL!
# Copy this file to .env or .env.local and fill in the values.

# === 1. Next.js App / Client ===
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001/api" # Render API backend

# === 2. Supabase / Auth ===
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here" # Server side only!

# === 3. Database (Prisma) ===
# Connection pooling for Serverless environments (Transaction mode)
DATABASE_URL="postgres://[db-user]:[password]@[host]:6543/[db-name]?pgbouncer=true&connection_limit=1"
# Direct connection for Prisma Migrations
DIRECT_URL="postgres://[db-user]:[password]@[host]:5432/[db-name]"

# === 4. Payments Sandbox (Escrow) ===
NEXT_PUBLIC_PAYMENT_SANDBOX_KEY="pk_test_..."
PAYMENT_SECRET_KEY="sk_test_..."
PAYMENT_WEBHOOK_SECRET="whsec_..."

# === 5. Communication (Email / SMS) ===
RESEND_API_KEY="re_..."
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1234567890"

# === 6. External Services (Maps, Weather) ===
NEXT_PUBLIC_MAPBOX_TOKEN="pk.eyJ1..."
NEXT_PUBLIC_WEATHER_API_KEY="weather_..."
